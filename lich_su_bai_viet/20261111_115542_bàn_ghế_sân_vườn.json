lywood</td><td>1 bàn HW-BD02A + 4 ghế HW-GV01/GT02</td><td>120×80cm + 56×44cm</td><td>10.100.000</td><td><strong>10.908.000</strong></td></tr>\n    <tr><td>Combo bàn chữ nhật 1m6 + 6 ghế Polywood</td><td>1 bàn HW-BD02B + 6 ghế HW-GV01/GT02</td><td>160×90cm + 56×44cm</td><td>13.300.000</td><td><strong>14.364.000</strong></td></tr>\n    <tr><td>Combo bàn chữ nhật 1m2 + 4 ghế Texilene</td><td>1 bàn HW-BD04A + 4 ghế HW-GL04</td><td>120×80cm + 65×54cm</td><td>13.870.000</td><td><strong>14.979.600</strong></td></tr>\n    <tr><td>Combo bàn chữ nhật 1m6 + 6 ghế Texilene</td><td>1 bàn HW-BD04B + 6 ghế HW-GL04</td><td>160×80cm + 65×54cm</td><td>18.630.000</td><td><strong>20.120.400</strong></td></tr>\n    <tr><td>Combo bàn chân X 1m4 + 4 ghế Polywood</td><td>1 bàn HW-BC04 + 4 ghế HW-GV01/GT02</td><td>140×80cm + 56×44cm</td><td>11.600.000</td><td><strong>12.528.000</strong></td></tr>\n    <tr><td>Combo bàn chân X 1m8 + 6 ghế Polywood</td><td>1 bàn HW-BC04A + 6 ghế HW-GV01/GT02</td><td>180×90cm + 56×44cm</td><td>16.550.000</td><td><strong>17.874.000</strong></td></tr>\n    <tr><td>Combo bàn rút chân X + 8 ghế Polywood</td><td>1 bàn HW-BR22 + 8 ghế HW-GV01/GT02</td><td>(180–240)cm + 56×44cm</td><td>25.100.000</td><td><strong>27.108.000</strong></td></tr>\n  </tbody>\n</table>\n\n<h2 style=\"color: #3b8632; border-bottom: 2px solid #3b8632; padding-bottom: 6px; margin-top: 25px;\">Chi Phí Phụ Kiện &amp; Nhân Công Lắp Đặt Bàn Ghế Sân Vườn</h2>\n\n<figure style=\"text-align: center; margin: 25px 0; padding: 18px; background-color: #f8fafc; border: 2px dashed #3b8632; border-radius: 8px;\">\n  <div style=\"font-size: 26px; margin-bottom: 6px;\">📸</div>\n  <div style=\"font-weight: bold; color: #1e293b; font-size: 0.95rem;\">[GỢI Ý HÌNH ẢNH: Bộ phụ kiện lắp đặt gồm vít inox, chốt liên kết, keo HWOOD 3X-BOND, thanh nẹp và dụng cụ bắt vít, bố trí phẳng trên nền gỗ]</div>\n  <figcaption style=\"\n<b>🎯 Thẻ Alt đề xuất:</b> Bộ phụ kiện lắp đặt bàn ghế sân vườn HWOOD gồm vít inox 304, chốt